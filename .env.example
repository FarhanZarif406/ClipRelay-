# ─────────────────────────────────────────────────────────────
# ClipRelay configuration. Copy to `.env` and fill in the blanks.
# docker-compose reads this file for the backend, worker and beat.
# ─────────────────────────────────────────────────────────────

# --- Core -------------------------------------------------------
ENVIRONMENT=production
# Long random string used to sign login tokens:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Fernet key that encrypts stored API keys:  python -m app.cli gen-key
# Never change it after keys are saved (they become unreadable).
ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=720
# The first account can always register; set true to let anyone with the URL sign up afterwards.
ALLOW_REGISTRATION=false

# Public URL of the app. Buffer fetches clips from it, and YouTube sends its push notifications to it.
# It can also be set in the app (Integrations → YouTube Push Notifications), which wins over this value.
# With docker-compose the frontend (nginx) proxies /api, so both point at the same origin.
# It has to be a public https:// address — use your domain or a tunnel (ngrok/cloudflared) locally.
PUBLIC_BASE_URL=https://cliprelay.example.com
FRONTEND_URL=https://cliprelay.example.com
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Database / Redis (docker-compose overrides the URLs) -------
POSTGRES_USER=cliprelay
POSTGRES_PASSWORD=cliprelay
POSTGRES_DB=cliprelay
DATABASE_URL=postgresql+psycopg://cliprelay:cliprelay@localhost:5432/cliprelay
REDIS_URL=redis://localhost:6379/0

# ─────────────────────────────────────────────────────────────
# Third-party API keys below are OPTIONAL here: a workspace owner can add, validate and
# change them in the app (Settings → API keys / AI models / Notifications) without a
# restart. Values saved in the app win; these .env values are the fallback.
# ─────────────────────────────────────────────────────────────

# --- YouTube (.env only) ------------------------------------------
# Optional YouTube Data API key. Without it, channel lookups read the public channel page and video
# details come from yt-dlp. The uploads feed and push notifications never need a key.
YOUTUBE_API_KEY=
# How original files are downloaded (see backend/app/services/sources.py).
VIDEO_SOURCE_ADAPTER=yt_dlp

# --- AI rewriting -----------------------------------------------
# Settings → AI models supports Anthropic, OpenAI, Gemini, OpenRouter, Groq, Mistral and custom
# endpoints. These LLM_* values are used only while no AI model has been added in the app
# (and are imported as the default model when you first upgrade).
# anthropic | openai  (openai = any OpenAI-compatible API; set LLM_BASE_URL for others)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
LLM_API_KEY=
LLM_BASE_URL=
LLM_MAX_TOKENS=600

# --- Email alerts (optional) -------------------------------------
# Settings → Notifications → Email (SMTP). Gmail: smtp.gmail.com, 587, starttls, app password.
SMTP_HOST=
SMTP_PORT=587
# starttls | ssl | none
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# --- Storage (.env only) ----------------------------------------
# local | s3   (s3 works with AWS, Cloudflare R2, MinIO, Backblaze B2, …)
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/media
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Media / limits ---------------------------------------------
FFMPEG_PATH=ffmpeg
# A bold .ttf for hook text. Empty: a usual system bold font (Arial Bold, DejaVu Sans Bold, …) is looked for.
FONT_FILE=
# true = run the scheduler and pipeline inside the API process (no Redis/Celery). For local use only.
INLINE_WORKER=false
SCHEDULER_TICK_SECONDS=30
# Quick work (new-video checks, captions, uploads): processes in the "worker" container.
WORKER_CONCURRENCY=2
# Downloads and edits ("media-worker"): places in all. MAX_RENDERS of them may be editing; the rest keep downloading.
MEDIA_CONCURRENCY=6
# Videos edited at the same time on the whole server, and encoder threads for each edit.
# 1 vCPU / 4 GB (Hostinger KVM 1): 3 and 1. More processors: raise MAX_RENDERS to about the number of vCPUs.
MAX_RENDERS=3
RENDER_THREADS=1
# PC Helper downloads shown to members (PC Helper page), e.g. the files of a GitHub release (.github/workflows/helper.yml).
HELPER_DOWNLOAD_WINDOWS=
HELPER_DOWNLOAD_MAC=
FRONTEND_PORT=8080
BACKEND_PORT=8000
