# ─────────────────────────────────────────────────────────────
# ClipRelay configuration. Copy to `.env` and fill in the blanks.
# docker-compose reads this file for the backend, worker and beat.
# ─────────────────────────────────────────────────────────────

# --- Core -------------------------------------------------------
ENVIRONMENT=production
# Long random string used to sign login tokens:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Fernet key that encrypts stored Instagram/TikTok tokens:  python -m app.cli gen-key
# Never change it after accounts are connected (existing tokens become unreadable).
ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=720
# The first account can always register; set true to let anyone with the URL sign up afterwards.
ALLOW_REGISTRATION=false

# Public URL of the app. OAuth redirect URIs are built from PUBLIC_BASE_URL:
#   {PUBLIC_BASE_URL}/api/instagram/oauth/callback
#   {PUBLIC_BASE_URL}/api/tiktok/oauth/callback
# With docker-compose the frontend (nginx) proxies /api, so both point at the same origin.
# Meta and TikTok require HTTPS redirect URIs — use your domain or a tunnel (ngrok/cloudflared) locally.
PUBLIC_BASE_URL=https://cliprelay.example.com
FRONTEND_URL=https://cliprelay.example.com
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Database / Redis (docker-compose overrides the URLs) -------
POSTGRES_USER=cliprelay
POSTGRES_PASSWORD=cliprelay
POSTGRES_DB=cliprelay
DATABASE_URL=postgresql+psycopg://cliprelay:cliprelay@localhost:5432/cliprelay
REDIS_URL=redis://localhost:6379/0

# --- Instagram (Instagram API with Instagram Login) -------------
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_API_VERSION=v21.0
INSTAGRAM_SCOPES=instagram_business_basic

# --- TikTok (Login Kit + Content Posting API) -------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Add user.info.profile if approved, to show @usernames instead of display names.
TIKTOK_SCOPES=user.info.basic,video.publish,video.list

# --- AI rewriting -----------------------------------------------
# anthropic | openai  (openai = any OpenAI-compatible API; set LLM_BASE_URL for others)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
LLM_API_KEY=
LLM_BASE_URL=
LLM_MAX_TOKENS=600

# Optional speech-to-text for the language gate (OpenAI-compatible /audio/transcriptions).
# Without it, the language gate classifies the caption text instead.
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
TRANSCRIPTION_MODEL=whisper-1

# --- Storage ----------------------------------------------------
# local | s3   (s3 works with AWS, Cloudflare R2, MinIO, Backblaze B2, …)
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/media
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Media / limits ---------------------------------------------
FFPROBE_PATH=ffprobe
FFMPEG_PATH=ffmpeg
MAX_VIDEO_DURATION_SEC=60
MAX_TIKTOK_ACCOUNTS=20
MAX_INSTAGRAM_SOURCES=7000
MONTHLY_JOB_QUOTA=1000
SCHEDULER_TICK_SECONDS=30
WORKER_CONCURRENCY=4
FRONTEND_PORT=8080
BACKEND_PORT=8000
